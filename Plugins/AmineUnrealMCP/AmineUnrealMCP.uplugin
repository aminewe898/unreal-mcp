    {"Name": "EditorScriptingUtilities", "Enabled": true},
    {"Name": "SequencerScripting", "Enabled": true},
    {"Name": "AutomationTestToolset", "Enabled": true},
    {"Name": "NiagaraToolsets", "Enabled": true, "Optional": true},
    {"Name": "PCGToolset", "Enabled": true, "Optional": true}
  ]
